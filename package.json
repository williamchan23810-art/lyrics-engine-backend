{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LyricsEngineTrackData",
  "type": "object",
  "properties": {
    "trackId": { "type": "string" },
    "title": { "type": "string" },
    "artist": { "type": "string" },
    "audioUrl": { "type": "string", "format": "uri" },
    "lyrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startTime": { "type": "number", "description": "Start time in seconds" },
          "endTime": { "type": "number", "description": "End time in seconds" },
          "text": { "type": "string" }
        },
        "required": ["startTime", "text"]
      }
    }
  },
  "required": ["trackId", "title", "artist", "audioUrl", "lyrics"]
}
