{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryboardData",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "conceptOverview": { "type": "string" },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneNumber": { "type": "integer" },
          "lyricSegment": { "type": "string" },
          "visualDescription": { "type": "string" },
          "aiVideoPrompt": { "type": "string" }
        },
        "required": ["sceneNumber", "lyricSegment", "visualDescription", "aiVideoPrompt"]
      }
    }
  },
  "required": ["title", "conceptOverview", "scenes"]
}
